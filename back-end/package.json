{
    "name": "back-end",
    "version": "1.0.0",
    "description": "Nomad Diary REST API",
    "main": "src/server.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "nodemon src/server.js",
        "start": "node src/server.js",
        "pm2:start": "NODE_ENV=production pm2 start src/server.js --name nomad-diary",
        "pm2:stop": "pm2 stop nomad-diary",
        "pm2:restart": "pm2 restart nomad-diary",
        "pm2:delete": "pm2 delete nomad-diary",
        "pm2:logs": "pm2 logs nomad-diary",
        "pm2:status": "pm2 list",
        "pm2:save": "pm2 save"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1106.0",
        "@aws-sdk/client-secrets-manager": "^3.1108.0",
        "@aws-sdk/s3-request-presigner": "^3.1106.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.22.0",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.4.3"
    },
