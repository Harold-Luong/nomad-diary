{
  "name": "location-catalog-lambda",
  "version": "0.1.0",
  "private": true,
  "description": "Vietnam Location Catalog API on AWS",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:load": "node scripts/load-runner.js",
    "dynamodb:migrate": "node infra/dynamodb/runners/migrate.js",
    "dynamodb:verify": "node infra/dynamodb/runners/verify.js",
    "dynamodb:import:provinces": "node infra/dynamodb/runners/import-provinces.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1109.0",
    "@aws-sdk/lib-dynamodb": "^3.1109.0"
  }
}
